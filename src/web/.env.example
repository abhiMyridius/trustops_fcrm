# Only for running the web app directly on your machine (`npm run dev`). Not needed with
# Docker: compose.dev.yaml sets both values itself. To change a default, copy to .env.local.
# msw  = in-browser mock backend fed by src/packages/seed (default while no service exists)
# live = the nginx gateway on :8080 (ADR-20), proxied by the Vite dev server
VITE_API_MODE=msw
# true = the login page shows the seeded-user picker (design C, C-05). No password is collected in demo mode.
VITE_DEMO_USERS=true
