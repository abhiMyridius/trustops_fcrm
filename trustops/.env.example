# TrustOps environment contract (design A §11.4). Names only, no values.
#
# You do not edit or copy this file. Run `make env`: it writes a SHORT .env
# (mode 0600, never overwritten) holding only the optional AWS keys, the
# commonly clashing host ports (commented out) and the generated secrets
# marked (required). Everything not in .env uses the default shown here in
# brackets. This file is the full reference for every setting.
#
# Lines `NAME=` are read by docker compose for ${NAME} interpolation; an
# empty value means "use the compose default" (shown in brackets). Lines
# `# NAME=` are set per container by docker-compose.yaml from the values
# above and the topology (ports, DB names, internal URLs); they are listed so
# this file documents every variable a container receives — do not set them
# here. `make compose-check` fails if this file and the compose files drift.
# Never commit a filled-in .env.

# ── Shared (every app container) ─────────────────────────────────────────
# Environment name: local | test | prod; selects ops/otel/env/<ENV>.yaml [local]
ENV=
# Python log level for every service and worker [INFO]
LOG_LEVEL=
# OTLP/HTTP endpoint every container exports traces/metrics/logs to [http://otel-collector:4318]
OTEL_EXPORTER_OTLP_ENDPOINT=
# (required) HMAC secret identity uses to mint fcrm_service tokens for H1/H2/S5 (X-Internal-Client)
SERVICE_TOKEN_SECRET=
# Path to seed.json inside the image; empty = the copy packaged with fcrm_seed [empty]
SEED_PATH=
# Load the P7 seed into empty collections at startup; false in prod [true]
SEED_ON_EMPTY=
# Public origin of the gateway, used for CORS and cookie checks [http://localhost:8080]
GATEWAY_ORIGIN=
# Set by compose: fcrm_app URI (readWrite on every DB except fcrm_audit); S4 gets the writer URI instead
# MONGODB_URI=
# Set by compose: amqp URI built from RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS
# RABBITMQ_URL=
# Set by compose: redis://redis:6379/0 (cache only)
# REDIS_URL=
# Set by compose: http/protobuf
# OTEL_EXPORTER_OTLP_PROTOCOL=
# Set by compose per container: identity, case, scoring, policy, audit, decision, caseflow, ...
# OTEL_SERVICE_NAME=
# Set by compose per container: component.id=<S1..H4,X1>,service.namespace=trustops
# OTEL_RESOURCE_ATTRIBUTES=
# Set by compose: identity JWKS (local RS256 verification)
# IDENTITY_JWKS_URL=
# Set by compose: identity /core/validate (fallback and nginx auth_request)
# IDENTITY_VALIDATE_URL=
# Set by compose: http://opa:8181 (route authz + tool permits, fail closed)
# OPA_URL=

# ── Per service ──────────────────────────────────────────────────────────
# Set by compose: public prefix the service mounts under (/api/fcrm, /api/fcrm/scoring, ...)
# APP_ROOT_PATH=
# Set by compose: the service's own database (fcrm_case, fcrm_scoring, ...)
# MONGODB_DB=
# Set by compose: listen port (ADR-20; 9100–9103 are worker health ports)
# PORT=
# S1 case + workers: S3 endpoint; unset on the AWS path for real S3 [http://minio:9000]
S3_ENDPOINT_URL=
# S1 case + workers: S3 region [us-east-1]
S3_REGION=
# Set by compose from MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Set by compose: bucket names (uploads, canonical, packs, vectors, jobs)
# S3_BUCKET_UPLOADS=
# S3_BUCKET_CANONICAL=
# S3_BUCKET_PACKS=
# S3_BUCKET_VECTORS=
# S3_BUCKET_JOBS=
# Set by compose: S1 upload limits and SSE heartbeat
# UPLOAD_MAX_BYTES=
# UPLOAD_ALLOWED_EXTENSIONS=
# SSE_HEARTBEAT_S=
# S2 scoring: recompute all 80 seed cases at startup and refuse readiness on a mismatch [true]
SEED_RECOMPUTE_ON_START=
# S3 policy + H4: vector backend, s3vectors | memory (ADR-12) [memory]
VECTOR_BACKEND=
# S3 policy + H4: S3 Vectors bucket for the three indexes [fcrm-vectors]
S3_VECTORS_BUCKET=
# S3 policy + H4: S3 Vectors region [us-east-1]
S3_VECTORS_REGION=
# S3 policy + H4: embedding provider, bedrock | dummy (ADR-12) [dummy]
EMBEDDING_PROVIDER=
# S3 policy + H4: embedding model override; empty = from ai/models/tiers.yaml (model ids live only there) [empty]
EMBEDDING_MODEL=
# Set by compose: 1024 (Titan Embed Text v2)
# EMBEDDING_DIMENSION=
# Set by compose: S3 hybrid search tuning
# RRF_K=
# SEARCH_TOP_K_MAX=
# Set by compose: S4 insert-only credential (fcrm_audit_writer); S4 also gets it as MONGODB_URI
# MONGODB_URI_AUDIT_WRITER=
# Set by compose: S5 committee quorum (3)
# COMMITTEE_QUORUM=
# Set by compose: X1 identity token settings
# JWT_KEY_FILE=
# JWT_ACCESS_TTL_S=
# JWT_REFRESH_TTL_S=
# JWT_ISSUER=
# JWT_AUDIENCE=
# REFRESH_COOKIE_NAME=
# X1 identity: bcrypt hash every seeded user logs in with; `make env` derives it from DEMO_PASSWORD (default demo-password-2026) [required]
DEMO_USERS_PASSWORD_HASH=
# X1 identity: login rate limit per IP (the gateway also limits 10/min) [10/minute]
LOGIN_RATE_LIMIT=

# ── Harness (H1 caseflow + H2 agent-worker, one process) ────────────────
# Set by compose: base URLs of S1–S5 on the api process, including their public prefix
# CASE_SERVICE_URL=
# SCORING_SERVICE_URL=
# POLICY_SERVICE_URL=
# AUDIT_SERVICE_URL=
# DECISION_SERVICE_URL=
# Set by compose: how many deliveries H1 and H2 work on at once (consumer prefetch)
# CASEFLOW_PREFETCH=
# AGENT_PREFETCH=
# Set by compose: agents call live Bedrock only; replay and mock modes were removed (ADR-27)
# FCRM_LLM_MODE=
# Set by compose: H2 prompts dir (the ai/ root), per-job tool-call cap
# PROMPTS_DIR=
# AGENT_MAX_TOOL_CALLS=
# H2 agent-worker: second Bedrock region for cross-region fallback [us-west-2]
BEDROCK_REGION_FALLBACK=
# Set by compose once H3 joins the harness: PDF engine, per-file timeout, Guard 1 config files
# PDF_ENGINE=
# UPLOADS_PER_FILE_TIMEOUT_SECONDS=
# GUARD1_ALLOWLIST_FILE=
# INJECTION_PATTERNS_FILE=
# PDF_MIN_CHARS_PER_PAGE=
# Set by compose once H4 joins the harness: synthesis switch, off (no LLM call during index builds)
# CONTEXT_SYNTHESIS_ENABLED=

# ── Platform (infra containers) ──────────────────────────────────────────
# (required) MongoDB root user, used only by mongo-init and the healthcheck
MONGO_INITDB_ROOT_USERNAME=
# (required) MongoDB root password
MONGO_INITDB_ROOT_PASSWORD=
# (required) password of fcrm_audit_writer, the insert-only audit user (S4 only)
MONGO_AUDIT_WRITER_PASSWORD=
# (required) password of fcrm_app, the services' user (no access to fcrm_audit); URL-safe characters only
MONGO_APP_PASSWORD=
# (required) RabbitMQ user (the only broker user; definitions.json declares none)
RABBITMQ_DEFAULT_USER=
# (required) RabbitMQ password; URL-safe characters only (it is embedded in RABBITMQ_URL)
RABBITMQ_DEFAULT_PASS=
# (required) MinIO root user (also the services' S3 access key locally)
MINIO_ROOT_USER=
# (required) MinIO root password
MINIO_ROOT_PASSWORD=
# MinIO image; upstream minio/minio is no longer pullable anonymously [bitnamilegacy/minio:2025.7.23]
MINIO_IMAGE=
# Grafana admin user [admin]
GF_SECURITY_ADMIN_USER=
# (required) Grafana admin password
GF_SECURITY_ADMIN_PASSWORD=
# Set by compose: Grafana hardening (no sign-up, no anonymous access, no phone-home)
# GF_USERS_ALLOW_SIGN_UP=
# GF_AUTH_ANONYMOUS_ENABLED=
# GF_ANALYTICS_REPORTING_ENABLED=
# GF_ANALYTICS_CHECK_FOR_UPDATES=
# GF_NEWS_NEWS_FEED_ENABLED=
# GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=
# Set by compose: mc alias for the MinIO healthcheck
# MC_HOST_local=

# ── Web (compose.dev.yaml only) ──────────────────────────────────────────
# Web data source: live (gateway) | mock (MSW) [live]
VITE_API_MODE=
# Show the demo user picker on the login screen [true]
VITE_DEMO_USERS=
# Set by compose.dev.yaml: file-watch polling for vite on bind mounts
# CHOKIDAR_USEPOLLING=

# ── Host ports (ADR-20 defaults; move one if it is taken on this machine) ─
# Interface host ports bind to; 0.0.0.0 exposes the stack to the LAN [127.0.0.1]
BIND_ADDRESS=
# [8080]
GATEWAY_HOST_PORT=
# [5173] vite dev server (compose.dev.yaml)
WEB_DEV_HOST_PORT=
# The api process (identity, case, scoring, policy, audit, decision on 8000) and
# the harness (health on 9100) have no host port: they are reached only through
# the gateway (GATEWAY_HOST_PORT) and on the compose network.
# [8181]
OPA_HOST_PORT=
# [27017] host clients need ?directConnection=true (the replica set advertises mongo:27017)
MONGO_HOST_PORT=
# [5672]
RABBITMQ_HOST_PORT=
# [15672] management UI
RABBITMQ_MGMT_HOST_PORT=
# [6379]
REDIS_HOST_PORT=
# [9000] S3 API
MINIO_HOST_PORT=
# [9001] MinIO console
MINIO_CONSOLE_HOST_PORT=
# [4317]
OTLP_GRPC_HOST_PORT=
# [4318]
OTLP_HTTP_HOST_PORT=
# [8889] collector's Prometheus exporter
OTEL_PROM_HOST_PORT=
# [13133] collector health_check extension
OTEL_HEALTH_HOST_PORT=
# [16686]
JAEGER_UI_HOST_PORT=
# [9090]
PROMETHEUS_HOST_PORT=
# [3000]
GRAFANA_HOST_PORT=

# ── AWS (live mode; also the deploy path in ops/aws) ─────────────────────
# Region for Bedrock, S3 and S3 Vectors; the standard boto3/AWS CLI name [us-east-1]
AWS_DEFAULT_REGION=
# Set by compose: the same value again, for the cloned context engine
# AWS_REGION=
# Bedrock + S3 Vectors credentials; empty keeps the stack in replay/memory mode (BUILD-PLAN §11)
AWS_ACCESS_KEY_ID=
# Secret for AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=
# Session token when the credentials are temporary (SSO / assumed role)
AWS_SESSION_TOKEN=
