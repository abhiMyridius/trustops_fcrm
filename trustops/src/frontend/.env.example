# Only for running the web app directly on your machine (`npm run dev`). Not needed with
# Docker: compose.dev.yaml sets both values itself. To change a default, copy to .env.local.
# live = the nginx gateway on :8080 (ADR-20), proxied by the Vite dev server. This is the default and
#        the only mode a production build has.
# msw  = in-browser mock backend fed by src/backend/packages/seed; use `npm run dev:msw` (it sets this
#        itself) for work without the stack. vitest and the MSW Playwright scenes use it too.
VITE_API_MODE=live
# true = the login page offers the seeded-user picker when identity serves one (design C, C-05). Identity
# serves it only when ENV is local and DEMO_USERS_ENABLED=true; otherwise the page shows a password form.
VITE_DEMO_USERS=true
