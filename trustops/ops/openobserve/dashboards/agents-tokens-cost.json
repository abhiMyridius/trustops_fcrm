{
  "version": 8,
  "title": "TrustOps · Agents, tokens and cost",
  "description": "Every agent job's tokens, list-price cost, wall time and budget use, recorded by the agent worker (ADR-72). Model is the tiers.yaml label of the model that answered.",
  "tabs": [
    {
      "tabId": "default",
      "name": "Default",
      "panels": [
        {
          "id": "Panel_ID1",
          "type": "metric",
          "title": "Tokens (time range)",
          "description": "Input (uncached), output and cache tokens of every agent job in the range.",
          "config": {
            "show_legends": false,
            "decimals": 0
          },
          "queryType": "promql",
          "queries": [
            {
              "query": "sum(increase(fcrm_agent_tokens_total[$__range]))",
              "customQuery": true,
              "fields": {
                "stream": "",
                "stream_type": "metrics",
                "x": [],
                "y": [],
                "z": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 48,
            "h": 8,
            "i": 1
          }
        },
        {
          "id": "Panel_ID2",
          "type": "metric",
          "title": "Cost USD (time range)",
          "description": "At the list prices in ai/models/tiers.yaml; an estimate, not an invoice.",
          "config": {
            "show_legends": false,
            "decimals": 4
          },
          "queryType": "promql",
          "queries": [
            {
              "query": "sum(increase(fcrm_agent_cost_usd_total[$__range]))",
              "customQuery": true,
              "fields": {
                "stream": "",
                "stream_type": "metrics",
