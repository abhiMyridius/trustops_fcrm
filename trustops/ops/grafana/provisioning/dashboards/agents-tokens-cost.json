            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(fcrm_agent_cost_usd_total[$__range])) / count(sum by (case_id) (increase(fcrm_agent_cost_usd_total[$__range])) > 0)",
