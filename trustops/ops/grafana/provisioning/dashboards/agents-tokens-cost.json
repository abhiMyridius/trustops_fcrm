    {
      "type": "stat",
      "id": 2,
      "title": "Tokens (time range)",
      "description": "All agent tokens in the selected range (fcrm_agent_tokens_total).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(fcrm_agent_tokens_total[$__range]))",
          "legendFormat": "tokens",
          "range": true,
          "instant": true
