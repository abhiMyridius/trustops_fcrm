{
  "_comment": "Registration of the hook scripts in this folder (design C 5.4). NOT active: nothing reads this file. To enable it copy the 'hooks' object into .claude/settings.local.json (yours only) or .claude/settings.json (everyone's) and start Claude Code in the folder that holds the Makefile (trustops/), so $CLAUDE_PROJECT_DIR is that folder. See README.md in this folder. Timeouts are in seconds.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ai/guidance/hooks/protect_paths.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ai/guidance/hooks/protect_paths.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ai/guidance/hooks/commit_guard.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/ai/guidance/hooks/fmt_py.sh\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/ai/guidance/hooks/fmt_ts.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ai/guidance/hooks/stop_gate.py\"",
            "timeout": 900
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ai/guidance/hooks/subagent_report.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/ai/guidance/hooks/stage_context.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
