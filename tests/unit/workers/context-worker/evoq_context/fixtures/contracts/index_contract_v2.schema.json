{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "index_contract_v2_vector_metadata",
  "description": "Per-vector metadata written by aeocontextjob and read by evoq_aidlc_mcp. List-valued fields are comma-joined strings.",
  "type": "object",
  "required": [
    "doc_id", "project", "source_type", "source_id", "content_hash", "chunk_key", "chunk_index", "offset",
    "chunk_strategy", "type", "snapshot_version", "index_contract", "text_truncated", "text"
  ],
  "properties": {
    "doc_id": { "type": "string" },
    "project": { "type": "string" },
    "source_type": { "type": "string", "enum": ["confluence", "jira", "file", "policy"] },
    "source_id": { "type": "string" },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "chunk_key": { "type": "string", "pattern": "^[a-z]+:[A-Za-z0-9]+:[0-9a-f]{16}:[0-9]{4}$" },
    "chunk_index": { "type": "integer", "minimum": 0 },
    "offset": { "type": "integer", "minimum": 0 },
    "chunk_strategy": { "type": "string", "enum": ["heading_sections", "paragraph_windows", "page_windows", "slide_units", "table_aware", "requirement_units", "comment_thread", "clause_units"] },
    "type": { "type": "string", "enum": ["markdown", "plain_text", "pdf", "paged", "tabular", "slides", "jira", "confluence"] },
    "page": { "type": "integer" },
    "slide": { "type": "integer" },
    "sheet": { "type": "string" },
    "heading_level": { "type": "integer" },
    "requirement_ids": { "type": "string", "description": "comma-joined, <= 20 items" },
    "labels": { "type": "string", "description": "comma-joined, <= 20 items" },
    "snapshot_version": { "type": "string", "pattern": "^v[0-9]+$" },
    "source_version": { "type": "string" },
    "index_contract": { "const": 2 },
    "text_truncated": { "type": "boolean" },
    "ingested_at": { "type": "string" },
    "kr_doc_id": { "type": "string" }, "category": { "type": "string" }, "effective_date": { "type": "string" },
    "expiry_date": { "type": "string" }, "jurisdiction": { "type": "string" }, "regulations_ref": { "type": "string" },
    "owner_id": { "type": "string" }, "kr_version": { "type": ["string", "integer"] },
    "row_range": { "type": "string" }, "row_count": { "type": "integer" }, "para_group": { "type": "integer" },
    "char_start": { "type": "integer" }, "char_end": { "type": "integer" }, "token_estimate": { "type": "integer" },
    "parent_key": { "type": "string", "pattern": "^[a-z]+:[A-Za-z0-9]+:[0-9a-f]{16}:[0-9]{4}$", "description": "v2.1: key of the stored-only structural parent (chunk_level=0)" },
    "chunk_level": { "type": "integer", "enum": [0, 1], "description": "v2.1: 0 = parent (stored-only) · 1 = child (embedded)" },
    "corpus_version": { "type": "string", "description": "TrustOps: corpus version, e.g. v14" },
    "trigger_type": { "type": "string", "description": "TrustOps: change trigger type(s), comma-joined" },
    "risk_area": { "type": "string", "description": "TrustOps: risk domain(s), comma-joined" },
    "closed_date": { "type": "integer", "description": "TrustOps: precedent close date, epoch days" },
    "clause_id": { "type": "string", "description": "TrustOps: policy clause id, e.g. FCRM42-3.1" },
    "index_kind": { "type": "string", "enum": ["clause", "precedent", "control"], "description": "TrustOps: which of the three indexes" },
    "topic_id": { "type": "string", "pattern": "^t\\d{3,}$", "description": "v2.1: deterministic lexical-cohesion topic id" },
    "text": { "type": "string", "maxLength": 12000 },
    "title": { "type": "string" },
    "section": { "type": "string" },
    "section_path": { "type": "string" },
    "hierarchy_path": { "type": "string" },
    "url": { "type": "string" },
    "source_path": { "type": "string" },
    "strategy_reason": { "type": "string" },
    "columns": { "type": "string" },
    "comment_range": { "type": "string" }
  },
  "additionalProperties": false
}
