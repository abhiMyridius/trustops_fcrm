{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "profile_hints",
  "description": "Deterministic, O(n) facts about a canonical Markdown body. Produced by evoq_ingestion.core.profile.compute_profile; consumed by aeocontextjob's strategy selector. Never contains a strategy decision.",
  "type": "object",
  "required": [
    "profile_version", "char_count", "word_count", "line_count", "paragraph_count", "avg_paragraph_words",
    "heading_count", "heading_density", "table_count", "table_text_ratio", "list_item_count", "list_item_ratio",
    "code_block_count", "code_char_ratio", "page_count", "sheet_count", "slide_count",
    "requirement_id_count", "requirement_id_unique", "requirement_id_density"
  ],
  "properties": {
    "profile_version": { "const": 1 },
    "char_count": { "type": "integer" },
    "word_count": { "type": "integer" },
    "line_count": { "type": "integer" },
    "non_blank_line_count": { "type": "integer" },
    "paragraph_count": { "type": "integer" },
    "avg_paragraph_words": { "type": "number" },
    "max_paragraph_words": { "type": "integer" },
    "sentence_count": { "type": "integer" },
    "avg_sentence_words": { "type": "number" },
    "heading_count": { "type": "integer" },
    "heading_levels": { "type": "object", "additionalProperties": { "type": "integer" } },
    "max_heading_depth": { "type": "integer" },
    "heading_density": { "type": "number", "description": "headings per 1,000 words" },
    "numbered_section_count": { "type": "integer", "description": "lines matching ^\\d+(\\.\\d+)+\\s+\\S outside code/tables" },
    "table_count": { "type": "integer" },
    "table_row_count": { "type": "integer" },
    "table_text_ratio": { "type": "number", "description": "chars in GFM table lines / char_count" },
    "list_item_count": { "type": "integer" },
    "list_item_ratio": { "type": "number", "description": "list lines / non-blank lines" },
    "code_block_count": { "type": "integer" },
    "code_char_ratio": { "type": "number" },
    "page_count": { "type": ["integer", "null"] },
    "sheet_count": { "type": ["integer", "null"] },
    "slide_count": { "type": ["integer", "null"] },
    "requirement_id_count": { "type": "integer" },
    "requirement_id_unique": { "type": "integer" },
    "requirement_id_density": { "type": "number", "description": "matches per 1,000 words" },
    "requirement_id_prefixes": { "type": "object", "additionalProperties": { "type": "integer" }, "description": "top-5 {prefix: count}, prefix = match up to the last '-'" },
    "link_count": { "type": "integer" },
    "image_count": { "type": "integer" },
    "replacement_char_ratio": { "type": "number" },
    "non_printable_ratio": { "type": "number" },
    "is_scanned_pdf": { "type": "boolean" },
    "language": { "type": "string", "description": "'und' unless language detection is enabled" },
    "body_prefix_sha1": { "type": "string" }
  },
  "additionalProperties": true
}
